{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "bookshelf",
  "compatibility_date": "2025-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "minify": true,
  "keep_vars": true,
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "bookshelf"
    }
  ],
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "BOOKS",
      "bucket_name": "books",
      "jurisdiction": "eu"
    }
  ]
}
