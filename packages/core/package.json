{
  "name": "@bookshelf/core",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "The library format and the ZIP reader, shared by the app and the sync tool",
  "author": "Murat Erkin Cicek",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/murerkinn/bookshelf.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/murerkinn/bookshelf#readme",
  "bugs": {
    "url": "https://github.com/murerkinn/bookshelf/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config-file.d.ts",
      "default": "./dist/config-file.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "check-types": "tsc --build",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@bookshelf/fixtures": "*",
    "@types/node": "^24",
    "typescript": "^7.0.2"
  }
}
