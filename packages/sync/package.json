{
  "name": "@bookshelf/sync",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Builds a library from a folder of books and publishes it to object storage",
  "author": "Murat Erkin Cicek",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/murerkinn/bookshelf.git",
    "directory": "packages/sync"
  },
  "homepage": "https://github.com/murerkinn/bookshelf#readme",
  "bugs": {
    "url": "https://github.com/murerkinn/bookshelf/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "bin": {
    "bookshelf-sync": "./dist/sync.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "check-types": "tsc --build",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "sync": "node ./dist/sync.js"
  },
  "dependencies": {
    "@bookshelf/core": "*",
    "@bookshelf/provider-fs": "*",
    "@bookshelf/provider-r2": "*"
  },
  "exports": {
    ".": {
      "types": "./dist/sync.d.ts",
      "default": "./dist/sync.js"
    },
    "./build": {
      "types": "./dist/lib/build.d.ts",
      "default": "./dist/lib/build.js"
    },
    "./bucket": {
      "types": "./dist/lib/bucket.d.ts",
      "default": "./dist/lib/bucket.js"
    },
    "./config": {
      "types": "./dist/lib/config.d.ts",
      "default": "./dist/lib/config.js"
    },
    "./epub": {
      "types": "./dist/lib/epub.d.ts",
      "default": "./dist/lib/epub.js"
    },
    "./metadata": {
      "types": "./dist/lib/metadata.d.ts",
      "default": "./dist/lib/metadata.js"
    },
    "./pdf": {
      "types": "./dist/lib/pdf.d.ts",
      "default": "./dist/lib/pdf.js"
    }
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^7.0.2"
  }
}
