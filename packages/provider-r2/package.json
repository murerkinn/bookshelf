{
  "name": "@bookshelf/provider-r2",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare R2 provider: a Worker binding to read, the wrangler CLI to publish",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "check-types": "tsc --build",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@bookshelf/core": "*"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  }
}
