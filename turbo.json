{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  // Which provider the library lives on is read out of this file at build
  // time, so it belongs in every task's cache key. Without it, changing the
  // provider and rebuilding replays the previous build — an artifact for the
  // wrong provider, and nothing says so.
  "globalDependencies": ["bookshelf.config.json", "bookshelf.config.jsonc"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", ".open-next/**"]
    },
    "check-types": {
      // The package's own build, not just its dependencies': the app's route
      // types are generated by `next build`, so typechecking it without
      // building it first fails on a cold cache and passes on a warm one.
      "dependsOn": ["build"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "sync": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "preview": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "deploy": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
