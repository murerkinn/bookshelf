{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  // Which provider the library lives on is read out of this file at build
  // time, so it belongs in every task's cache key. Without it, changing the
  // provider and rebuilding replays the previous build — an artifact for the
  // wrong provider, and nothing says so.
  "globalDependencies": ["bookshelf.config.json", "bookshelf.config.jsonc"],
  "tasks": {
    // pdf.js fetches its worker, its CMaps, its standard fonts and its wasm
    // over HTTP rather than importing them, so a bundler never sees them and
    // something has to put them under `public/` before the app is served.
    // Uncached because the script is idempotent and stamps the version it
    // copied: a second run compares one file and exits, which is cheaper than
    // restoring four megabytes from a cache.
    "assets": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "assets"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    // Bundling for workerd is a step past `next build`, and it shells out to
    // `next build` itself — which loads next.config.ts, which imports
    // @bookshelf/core. Running it through Turborepo is what gets that package
    // built first; invoking the CLI directly does not.
    "bundle": {
      "dependsOn": ["^build", "assets"],
      "outputs": [".open-next/**"]
    },
    "check-types": {
      // The package's own build, not just its dependencies': the app's route
      // types are generated by `next build`, so typechecking it without
      // building it first fails on a cold cache and passes on a warm one.
      "dependsOn": ["build"]
    },
    "dev": {
      "dependsOn": ["^build", "assets"],
      "cache": false,
      "persistent": true
    },
    // Its own build too, not just its dependencies': the CLI is TypeScript and
    // runs from `dist`, like every other package here.
    "sync": {
      "dependsOn": ["build"],
      "cache": false
    },
    // Each package runs its own tests, against the dist its build produces —
    // so a change to one package re-runs only its own, and they run in
    // parallel. The app's reach into its `src` directly, which is why that one
    // depends on nothing being built.
    "test": {
      "dependsOn": ["build", "^build"],
      "outputs": []
    },
    "preview": {
      "dependsOn": ["^build", "assets"],
      "cache": false,
      "persistent": true
    },
    "deploy": {
      "dependsOn": ["^build", "assets"],
      "cache": false
    }
  }
}
