{
  "name": "bookshelf",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "npm@11.16.0",
  "description": "A self-hostable ebook library over object storage",
  "author": "Murat Erkin Cicek",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/murerkinn/bookshelf.git"
  },
  "homepage": "https://github.com/murerkinn/bookshelf#readme",
  "bugs": {
    "url": "https://github.com/murerkinn/bookshelf/issues"
  },
  "keywords": [
    "ebook",
    "epub",
    "library",
    "self-hosted",
    "cloudflare-workers",
    "r2",
    "calibre"
  ],
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@xmldom/xmldom": "^0.8.14"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "bundle": "turbo run bundle",
    "sync": "turbo run sync --log-prefix=none --output-logs=new-only --",
    "demo": "turbo run build --filter=@bookshelf/fixtures --log-prefix=none --output-logs=errors-only && node tools/demo.mjs",
    "deploy": "turbo run deploy --log-prefix=none --",
    "preview": "turbo run preview --log-prefix=none --",
    "test": "turbo run test",
    "lint": "biome check",
    "format": "biome format --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "turbo": "^2.10.11"
  }
}
