{
  "name": "bookshelf",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "description": "A self-hostable ebook library over object storage",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "sync": "turbo run sync --log-prefix=none --output-logs=new-only --",
    "deploy": "turbo run deploy --log-prefix=none --",
    "preview": "turbo run preview --log-prefix=none --",
    "lint": "biome check",
    "format": "biome format --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "turbo": "^2.10.11"
  }
}
